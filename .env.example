# ---------------------------------------------------------------------------
# VPN Master backend — environment. Copy to `.env` for local dev.
# On Render, set these in the dashboard / render.yaml (never commit real .env).
# ---------------------------------------------------------------------------

# HTTP
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Postgres (Render injects DATABASE_URL from the linked database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vpnmaster
PGSSL=false            # "true" for managed Postgres (Render/Heroku)
PG_POOL_MAX=10

# App key gate (X-API-Key). Comma-separated for rotation.
# REQUIRED in production. If empty in dev, the gate is open.
API_KEYS=dev-local-key

# Device bearer tokens (POST /v1/devices) + node-secret signing.
JWT_SECRET=change-me-in-prod
DEVICE_TOKEN_TTL=365d
DEVICE_TOKEN_TTL_DAYS=365

# WireGuard node agents (provisioner='agent' servers report in with this).
NODE_AGENT_SECRET=
NODE_AGENT_TIMEOUT_MS=8000

# Session lifecycle
PEER_TTL_MINUTES=30
REAPER_INTERVAL_MS=300000
ENABLE_PSK=true        # generate a preshared key per peer

# Plans / quotas (served via GET /v1/config; enforced on the node).
FREE_LIMIT_BYTES=1073741824      # 1 GB
FREE_PERIOD=monthly
PREMIUM_UNLIMITED=false
PREMIUM_LIMIT_BYTES=107374182400 # 100 GB
PREMIUM_PERIOD=monthly

# Remote config
DEFAULT_DNS=1.1.1.1,1.0.0.1
TERMS_URL=https://vpnmaster.example.com/terms
PRIVACY_URL=https://vpnmaster.example.com/privacy
MIN_SUPPORTED_VERSION=1.0.0
FORCE_UPDATE=false
